# Server port (optional)
PORT=3000

# Asana integration — Daily Games Overview
# 1) Token: https://app.asana.com/0/my-apps → Create new token (Personal access token)
# 2) Project GID: open the project in Asana; URL is https://app.asana.com/0/PROJECT_GID/list
#    Or run: node scripts/asana-setup.js (after setting ASANA_ACCESS_TOKEN)
ASANA_ACCESS_TOKEN=
ASANA_PROJECT_GID=

# Optional: override project name when running asana-setup.js
# ASANA_PROJECT_NAME=Daily Games Overview

# Telegram (existing, optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Asana → Telegram reminders (optional; tasks need due_at with time in Asana)
ASANA_REMINDER_ENABLED=1
ASANA_REMINDER_MINUTES_BEFORE=60
ASANA_REMINDER_POLL_MS=120000
ASANA_REMINDER_DUE_GRACE_MS=1800000

# Public COMP URL (enables [link] in Telegram reminders)
COMP_PUBLIC_BASE_URL=
